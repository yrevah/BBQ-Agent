# Postgres (must support pgvector). Local example shown.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bbq_agent"

# Auth.js
AUTH_SECRET=""                 # openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# Google OAuth (Drive + Keep + Sign-in)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Anthropic (LLM)
ANTHROPIC_API_KEY=""

# Embeddings
OPENAI_API_KEY=""              # used for text-embedding-3-small

# Google Keep (unofficial gkeepapi master token, optional until live sync is on)
GOOGLE_KEEP_MASTER_TOKEN=""

# WhatsApp (Meta Cloud API — wired in a later phase)
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
